# Servidor
NODE_ENV=development
PORT=3000

# Credenciales de la cuenta que administra el inventario
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Inventario123!

# Usa una clave aleatoria larga en producción (por ejemplo: openssl rand -hex 32)
SESSION_SECRET=secreto-solo-para-desarrollo

# Opcional: URL de una base de datos PostgreSQL. Sin ella se usa almacenamiento JSON local.
DATABASE_URL=
# Actívalo si la conexión PostgreSQL externa exige SSL; para una conexión interna de Render normalmente puede dejarse false.
DATABASE_SSL=false
